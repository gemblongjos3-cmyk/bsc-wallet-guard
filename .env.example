# Copy to .env and fill in. No secrets are committed.
PORT=8787
# Comma-separated BSC RPC endpoints (public defaults work out of the box)
BSC_RPC_URLS=https://bsc-dataseed.binance.org,https://bsc-rpc.publicnode.com,https://1rpc.io/bnb
# Optional: HMAC secret issued by the Agent Games platform when the agent is
# registered ("Rotate Secret"). When set, POST /task requires a valid
# x-agent-games-signature header and every response is signed.
AGENT_GAMES_HMAC_SECRET=
